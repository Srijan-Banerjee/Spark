{
  "rules": {
    ".read": false,
    ".write": false,

    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && $name.matches(/^[a-z0-9_]{3,20}$/)"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",

        "username": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "usernameLower": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "avatarColorIndex": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 8" },
        "createdAt": { ".validate": "newData.isNumber()" },

        "friends": {
          ".read": "auth != null && auth.uid === $uid",
          "$otherUid": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && (!newData.exists() || root.child('friendRequests/' + auth.uid + '/' + $uid).exists() || root.child('friendRequests/' + $uid + '/' + auth.uid).exists())))",
            ".validate": "newData.hasChildren() ? newData.child('since').isNumber() : (!newData.exists() || newData.isBoolean())"
          }
        },

        "visibility": {
          ".read": "auth != null",
          "$otherUid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && (newData.val() === 'full' || newData.val() === 'lastSeenOnly' || newData.val() === 'hidden' || newData.val() === 'blocked' || newData.val() === 'unblocked')"
          }
        },

        "favorites": {
          ".read": "auth != null && auth.uid === $uid",
          "$otherUid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        },

        "$other": {
          ".validate": false
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users/' + $uid + '/friends/' + auth.uid).exists() && root.child('users/' + $uid + '/visibility/' + auth.uid).val() !== 'hidden' && root.child('users/' + $uid + '/visibility/' + auth.uid).val() !== 'blocked'))",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'lastChanged', 'lastSeen'])",
        "state": {
          ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'screenOn' || newData.val() === 'inactive' || newData.val() === 'offline' || newData.val() === 'ghost')"
        },
        "lastChanged": { ".validate": "newData.isNumber()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "device": { ".validate": "newData.isString()" },
        "app": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "isIdle": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },

    "friendRequests": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$fromUid": {
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $toUid)",
          ".validate": "newData.hasChildren(['from', 'ts', 'status', 'via'])",
          "from": { ".validate": "newData.val() === auth.uid" },
          "ts": { ".validate": "newData.isNumber()" },
          "status": { ".validate": "newData.val() === 'pending'" },
          "via": {
            ".validate": "(newData.val() === 'search') || (newData.val() === 'code' && root.child('inviteCodes/' + newData.parent().child('code').val() + '/uid').val() === $toUid)"
          },
          "code": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "$other": { ".validate": false }
        }
      }
    },

    "sentRequests": {
      "$fromUid": {
        ".read": "auth != null && auth.uid === $fromUid",
        "$toUid": {
          ".write": "auth != null && (auth.uid === $fromUid || (auth.uid === $toUid && !newData.exists()))",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "inviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.child('uid').val() === auth.uid && !newData.exists()))",
        ".validate": "newData.hasChildren(['uid', 'ts'])",
        "uid": { ".validate": "newData.isString()" },
        "ts": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
